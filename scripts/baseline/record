#!/usr/bin/env python3
"""Record a measured run in the repo: scripts/baseline/results/<run>.json, and
beside it scripts/baseline/results/<run>/ holding what the trial decided —
its generator spec (spec.toml), or the composition, implementations, and
generator specs it wrote into story-drafting/specs/, and its root tests
(tests/test_*.py) —
so a later grader can rescore it from the repo alone. The specs and tests are
copied from the trial's working tree, which is what was measured, and any
that differ from its commit are listed in the record as
decisions_uncommitted.

The full metrics.json stays in .baseline-runs/ (gitignored). The recorded copy
drops the machine-local parts — absolute paths become <repo>, and the
worktree path is removed — so the numbers can be committed and compared
across branches. The spec comes from .baseline-runs/<run>/spec.toml.

    scripts/baseline/record <run-name>
"""

from __future__ import annotations

import json
import pathlib
import subprocess
import sys


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit("usage: scripts/baseline/record <run-name>")
    name = sys.argv[1]
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True, check=True).stdout.strip()
    main_checkout = pathlib.Path(common).parent
    source = main_checkout / ".baseline-runs" / name / "metrics.json"
    text = source.read_text()
    for local in (str(main_checkout / ".claude" / "worktrees" / f"run-{name}"), str(main_checkout), str(pathlib.Path.home())):
        text = text.replace(local, "<repo>" if local != str(pathlib.Path.home()) else "~")
    metrics = json.loads(text)
    worktree = pathlib.Path(json.loads(source.read_text())["run"]["worktree"])
    metrics["run"].pop("worktree", None)
    target = pathlib.Path(__file__).resolve().parent / "results" / f"{name}.json"
    target.parent.mkdir(exist_ok=True)
    target.write_text(json.dumps(metrics, indent=2) + "\n")
    print(target)

    decided = target.parent / name
    spec_path = main_checkout / ".baseline-runs" / name / "spec.toml"
    decisions = {"spec.toml": spec_path.read_text()} if spec_path.is_file() else {}
    head = metrics["diff"]["head"]
    measured = {}
    for filename in ("composition.toml", "implementations.toml", "generator.toml"):
        path = worktree / "story-drafting" / "specs" / filename
        if path.is_file():
            measured[filename] = (path, f"story-drafting/specs/{filename}")
    tests = worktree / "story-drafting" / "tests"
    for path in sorted(tests.glob("test_*.py")) if tests.is_dir() else []:
        measured[path.name] = (path, f"story-drafting/tests/{path.name}")
    uncommitted = []
    for filename, (path, relative) in measured.items():
        decisions[filename] = path.read_text()
        committed = subprocess.run(["git", "show", f"{head}:{relative}"], capture_output=True, text=True, cwd=main_checkout)
        if committed.returncode != 0 or committed.stdout != decisions[filename]:
            uncommitted.append(filename)
    if uncommitted:
        print(f"record: {name}: measured decisions differ from the commit: {uncommitted}", file=sys.stderr)
    metrics["decisions_uncommitted"] = uncommitted
    target.write_text(json.dumps(metrics, indent=2) + "\n")
    for filename, text in decisions.items():
        decided.mkdir(exist_ok=True)
        (decided / filename).write_text(text)
        print(decided / filename)


if __name__ == "__main__":
    main()
