#!/usr/bin/env bash
#
# Prepare one baseline run: a fresh worktree for a subagent to work one phase
# of the story-drafting build in.
#
#   scripts/baseline/prepare red   <base-ref>        <run-name>
#   scripts/baseline/prepare green <red-run-branch>  <run-name>
#
# The worktree is .claude/worktrees/run-<run-name> on branch
# baseline/runs/<run-name>, cut from <base-ref>, so every run of a phase
# starts from the same commit. The orchestrating session then spawns a
# subagent with scripts/baseline/prompts/<phase>.md and the worktree path, and
# afterwards runs scripts/baseline/measure on the subagent's transcript.
# It also replaces the tree's Restate container with a fresh one. Outputs land
# in .baseline-runs/<run-name>/ in the main checkout (gitignored: transcripts
# carry machine-local paths); scripts/baseline/record commits the numbers.
#
set -euo pipefail

if [ $# -ne 3 ]; then
  echo "usage: scripts/baseline/prepare red|green <base-ref> <run-name>" >&2
  exit 2
fi
phase=$1
base=$2
name=$3

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[ -f "$HERE/prompts/$phase.md" ] || { echo "baseline: no prompt for phase '$phase'" >&2; exit 2; }

MAIN=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
wt="$MAIN/.claude/worktrees/run-$name"
branch="baseline/runs/$name"
out="$MAIN/.baseline-runs/$name"
[ ! -e "$wt" ] || { echo "baseline: $wt already exists" >&2; exit 1; }
[ ! -e "$out" ] || { echo "baseline: $out already exists" >&2; exit 1; }
mkdir -p "$out"

# A fresh Restate server per run: a run's registrations (and a stray host's)
# otherwise stay on the server and shape the next run's design.
docker rm -f tesser-story-drafting-restate >/dev/null 2>&1 || true
docker run -d --name tesser-story-drafting-restate -p 38080:8080 -p 39070:9070 \
  --add-host=host.docker.internal:host-gateway restatedev/restate:1.7 >/dev/null
for _ in $(seq 1 50); do
  if curl -sf http://localhost:39070/health >/dev/null; then break; fi
  sleep 0.2
done

base_sha=$(git rev-parse "$base^{commit}")
git worktree add -q -b "$branch" "$wt" "$base_sha"

cat >"$out/run.json" <<JSON
{"phase": "$phase", "name": "$name", "base_ref": "$base", "base_sha": "$base_sha", "branch": "$branch", "worktree": "$wt", "prepared": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"}
JSON
echo "$wt"
