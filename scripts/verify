#!/usr/bin/env bash
#
# Every Python gate CI runs, runnable locally, one command per tree.
#
#   scripts/verify              all trees
#   scripts/verify python-app   one tree
#   scripts/verify serdepy python-app
#
# Each CI job calls this with its own tree, so the commands live here — in the
# repo, reviewable — rather than inline in workflow YAML. That is the point:
# "green locally" and "green in CI" have to mean the same thing, and they only
# do if there is one definition of what green is.
#
# Tools are taken from PATH, exactly as in CI. Install them into the active
# environment with scripts/install-dev.
#
set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT" || exit 1

# Step 0 is the layout app (layout/ — a full tesser app with its own gates):
# it fails when the directories on disk, manifest.json, the .tesser-root
# files, and the CI jobs disagree in any direction. The tree list also comes
# from the layout app, never hand-maintained here: an `app` manifest row IS
# the claim that scripts/verify runs that tree, and a manifest tree with no
# run_* arm below fails as "unknown tree" rather than silently not running.
(cd "$ROOT/layout" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.check "$ROOT") || exit 1

# Capture the output in a variable first: a python3 failure inside process
# substitution would be invisible, and an empty TREES list would make the
# loop below report "all green (0 trees)" — a check that passes without
# checking anything.
TREE_LIST=$( (cd "$ROOT/layout" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.trees "$ROOT") ) || { echo "verify: could not derive trees from manifest.json" >&2; exit 1; }
# Read with a while loop, not mapfile: mapfile is a bash 4 builtin and macOS
# ships bash 3.2. Every CI job runs on ubuntu, so a bash-4-ism here fails only
# on the machine this script exists to serve, and CI can never see it.
TREES=()
while IFS= read -r tree; do
  if [ -n "$tree" ]; then TREES+=("$tree"); fi
done <<<"$TREE_LIST"
if [ ${#TREES[@]} -eq 0 ] || [ -z "${TREES[0]}" ]; then
  echo "verify: no gated trees derived from manifest.json" >&2
  exit 1
fi

failed=()

step() { echo "  → $*"; }

# The analyzer is an app, and an app is run through its host: tessercheck-py's
# srv/cli/main.py. It runs from tessercheck-py's own directory — `-m
# srv.cli.main` resolves against the current directory first, and a checked
# tree may have an srv package of its own — so the tree to check is an
# argument, not the working directory.
tessercheck_tree() {
  (cd "$ROOT/tessercheck-py" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.main "$1")
}

# host_identity <pid>: the start time of a process, empty when there is none.
# Captured right after a host is launched, it is what makes a pid mean "the
# host we started": a pid the OS has handed to another process starts at
# another time.
host_identity() {
  ps -o lstart= -p "$1" 2>/dev/null
}

# stop_host <pid> <signal> <identity>: signals a served host, gives it two
# seconds to exit, then kills it. A host whose Restate endpoint holds a
# suspended invocation otherwise outlives its root tier by Restate's
# inactivity timeout (about a minute), because cancelling that invocation's
# task waits on Restate. It signals only a process whose start time is the
# identity captured at launch, at every step: a host that has exited is never
# signalled again (its pid may be another process's by then), and a pid that
# now names a different process is not mistaken for the host.
stop_host() {
  local pid=$1 signal=$2 identity=$3 _
  if [ -n "$identity" ] && [ "$(host_identity "$pid")" = "$identity" ]; then
    kill "-$signal" "$pid" 2>/dev/null
    for _ in $(seq 1 20); do
      [ "$(host_identity "$pid")" = "$identity" ] || break
      sleep 0.1
    done
    if [ "$(host_identity "$pid")" = "$identity" ]; then
      kill -KILL "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null
  fi
}

run_llmport() {
  cd "$ROOT/examples/llmport" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict scheduling protocol conftest.py || return 1
  step "pytest"
  pytest -q || return 1
}

run_python_app() {
  cd "$ROOT/examples/python-app" || return 1
  step "ruff (env edge + exit edge + dead imports + F823)"
  ruff check . || return 1
  step "import-linter (import direction)"
  PYTHONPATH=. lint-imports || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict protocol kernel campaign linkpolicy reports app srv tests conftest.py || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  # The app reads its own environment through the config repository, so the
  # runner supplies one — the same job a deploy does. Tests never inject it.
  step "pytest (every tier but the root, no host served)"
  CAMPAIGN_STORAGE=memory LINKPOLICY_STORAGE=memory HTTP_HOST= HTTP_PORT=8080 \
    pytest -q --ignore=tests || return 1
  # The root tier plays the user: it reaches the app only through a running
  # host, so the arm serves the HTTP host and passes its address to the tier
  # as pytest's --host option. Locally the default port is 9240.
  local port="${PYTHON_APP_PORT:-9240}"
  local address="127.0.0.1:$port"
  step "serve the HTTP host on $address"
  (exec env CAMPAIGN_STORAGE=memory LINKPOLICY_STORAGE=memory HTTP_HOST=127.0.0.1 HTTP_PORT="$port" \
    PYTHONPATH=.:../../tesser-py python3 -W ignore::RuntimeWarning -m srv.http.main >/dev/null) &
  local host=$!
  local serving=1
  for _ in $(seq 1 50); do
    if curl -sf "http://$address/reports/links-by-verdict" >/dev/null; then
      serving=0
      break
    fi
    sleep 0.2
  done
  if [ "$serving" -ne 0 ]; then
    echo "python-app: the HTTP host did not answer on $address" >&2
    kill "$host" 2>/dev/null
    wait "$host" 2>/dev/null
    return 1
  fi
  step "pytest (root tier against the HTTP host at $address)"
  pytest -q tests --host "http://$address"
  local status=$?
  kill -INT "$host" 2>/dev/null
  wait "$host" 2>/dev/null
  [ "$status" -eq 0 ] || return 1
}

# The canonical application-ports tree: one context, two ports, an enum outcome
# and a collection answer. The six rejected encodings it was chosen over are not
# here on purpose — four of them exist *because* they produce findings, so a
# zero-findings gate is the wrong shape for them. They stay executable on the
# spike/application-ports branch, and docs/design-application-ports.md carries
# the measurements.
run_ports() {
  cd "$ROOT/examples/ports" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict catalog || return 1
  step "pytest"
  pytest -q || return 1
}

# The minimal tree: a small app that uses every tesser role and object in a
# conformant way, with about one test per sibling test file and the least
# business logic that shows how things work. Two contexts, a kernel, an
# exported kernel, protocol, srv, and app; alpha's durable kinds run on
# Restate. The arm runs the tiers in the runner's order
# (docs/design-test-tiers.md): every test outside the root tier first, with no
# host served — alpha's context test serves the component's containers from
# its own process under their own names, and each activities, workflows, and
# dispatchers test serves its own registrations under fresh names, all at
# MINIMAL_CALLBACK_HOST — then it serves srv/restate, registers it with the
# Restate admin API (forcing over what the context test left), and runs the
# root tier against it.
# CI provides a Restate service container; locally the defaults are a server
# of its own on 58080/59070. alpha's widgets are in Postgres at ALPHA_STORAGE;
# locally the default is a `minimal` database on the asyncpg arm's server
# (CREATE DATABASE minimal once):
#
#   docker run -d --name tesser-minimal-restate -p 58080:8080 -p 59070:9070 \
#     --add-host=host.docker.internal:host-gateway restatedev/restate:1.7
run_minimal() {
  cd "$ROOT/examples/minimal" || return 1
  local storage="${ALPHA_STORAGE:-postgres://tesser@localhost:5434/minimal}"
  local ingress="${RESTATE_INGRESS:-http://localhost:58080}"
  local admin="${RESTATE_ADMIN:-http://localhost:59070}"
  local port="${MINIMAL_DEPLOYMENT_PORT:-9085}"
  local callback_host="${MINIMAL_CALLBACK_HOST:-host.docker.internal}"
  local deployment="${MINIMAL_DEPLOYMENT:-http://$callback_host:$port}"
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict kernel shared protocol alpha beta app srv tests conftest.py || return 1
  step "pytest, every tier but the root (no host served; Postgres at ALPHA_STORAGE, Restate at $ingress)"
  ALPHA_STORAGE="$storage" BETA_KEY=k RESTATE_INGRESS="$ingress" RESTATE_ADMIN="$admin" \
    MINIMAL_CALLBACK_HOST="$callback_host" pytest -q --ignore=tests || return 1
  step "serve the Restate endpoint on :$port and register it at $admin"
  (exec env ALPHA_STORAGE="$storage" BETA_KEY=k RESTATE_INGRESS="$ingress" PYTHONPATH=.:../../tesser-py \
    python3 -m srv.restate.main "0.0.0.0:$port") &
  local host=$!
  local registered=1
  for _ in $(seq 1 50); do
    if curl -sf -X POST "$admin/deployments" -H 'content-type: application/json' \
      -d "{\"uri\": \"$deployment\", \"force\": true}" >/dev/null; then
      registered=0
      break
    fi
    sleep 0.2
  done
  if [ "$registered" -ne 0 ]; then
    echo "minimal: could not register $deployment with $admin" >&2
    kill "$host" 2>/dev/null
    wait "$host" 2>/dev/null
    return 1
  fi
  step "pytest, the root tier (against the served host)"
  ALPHA_STORAGE="$storage" BETA_KEY=k RESTATE_INGRESS="$ingress" pytest -q tests
  local status=$?
  kill -INT "$host" 2>/dev/null
  wait "$host" 2>/dev/null
  return "$status"
}

# The durable-execution example: one context whose workflows run on Restate.
# One FastAPI host serves POST /submissions, /orders and /purchases and mounts
# the Restate endpoint at /restate; the engine never touches the domain. The
# adapter tests exercise the real engine (testing.md rule 10). The arm runs the
# tiers in the runner's order (docs/design-test-tiers.md): every tier but the
# root first, with no host served — the context test serves and registers the
# component's containers under their own names at DURABLE_CALLBACK_HOST, and
# each activities, workflows, and dispatchers test its own under fresh names,
# then reads what the engine recorded in sys_invocation — then the arm serves
# the host, registers it with the Restate admin API (forcing over whatever the
# context tier left), and passes its address as pytest's --host option to the
# root-tier tests, which reach the app only through it. The app reads its own
# environment through the config repository, so the runner supplies it — the
# same job a deploy does. Tests never inject it. CI provides a Restate service
# container; locally the defaults are a server of its own on 18080/19070, so a
# local run never re-registers another tree's services:
#
#   docker run -d --name tesser-durable-restate -p 18080:8080 -p 19070:9070 \
#     --add-host=host.docker.internal:host-gateway restatedev/restate:1.7
run_durable_execution() {
  cd "$ROOT/examples/durable-execution" || return 1
  local ingress="${RESTATE_INGRESS:-http://localhost:18080}"
  local admin="${RESTATE_ADMIN:-http://localhost:19070}"
  local port="${DURABLE_DEPLOYMENT_PORT:-9084}"
  local callback_host="${DURABLE_CALLBACK_HOST:-host.docker.internal}"
  local deployment="${DURABLE_DEPLOYMENT:-http://$callback_host:$port}"
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict protocol ordering app srv tests conftest.py || return 1
  step "pytest every tier but the root (against Restate at $ingress, no host served)"
  RESTATE_INGRESS="$ingress" RESTATE_ADMIN="$admin" DURABLE_CALLBACK_HOST="$callback_host" \
    pytest -q --ignore=tests || return 1
  step "serve the Restate endpoint on :$port and register it at $admin"
  (exec env RESTATE_INGRESS="$ingress" PYTHONPATH=.:../../tesser-py \
    python3 -m srv.http.main "0.0.0.0:$port") &
  local host=$!
  local registered=1
  for _ in $(seq 1 50); do
    if curl -sf -X POST "$admin/deployments" -H 'content-type: application/json' \
      -d "{\"uri\": \"$deployment/restate\", \"force\": true}" >/dev/null; then
      registered=0
      break
    fi
    sleep 0.2
  done
  if [ "$registered" -ne 0 ]; then
    echo "durable-execution: could not register $deployment/restate with $admin" >&2
    kill "$host" 2>/dev/null
    wait "$host" 2>/dev/null
    return 1
  fi
  step "pytest the root tier (against the host on :$port)"
  pytest -q tests --host "http://127.0.0.1:$port"
  local status=$?
  kill -INT "$host" 2>/dev/null
  wait "$host" 2>/dev/null
  return "$status"
}

# The minimal tree with a real database behind it: the same two contexts, each
# with an asyncpg repository behind a store that owns the transaction — it is
# Postgres-only, there is no memory backend to fall back to — an async
# client/service/port chain, and an e2e that runs the CLI host as a
# subprocess and speaks only protocol to it. The app reads its own
# environment through the config repository, so the runner supplies it — the
# same job a deploy does, and the e2e passes it on to the host. Tests never
# inject it. The gate needs a reachable Postgres at that
# coordinate — there is no skip, because a skipped e2e is a gate that passes
# without checking anything. CI provides a service container; locally:
#
#   docker run -d --name tesser-asyncpg-pg -e POSTGRES_USER=tesser \
#     -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=tesser -p 5434:5432 postgres:16
#
# Trust auth on a throwaway container means the DSN carries no password, so
# nothing credential-shaped is ever committed.
run_asyncpg() {
  cd "$ROOT/examples/asyncpg" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict kernel shared protocol alpha beta app srv tests pgdatabase conftest.py || return 1
  step "pytest (against Postgres at ALPHA_STORAGE / BETA_STORAGE)"
  ALPHA_STORAGE="${ALPHA_STORAGE:-postgres://tesser@localhost:5434/tesser}" \
  BETA_STORAGE="${BETA_STORAGE:-postgres://tesser@localhost:5434/tesser}" \
    pytest -q || return 1
}

run_serdepy() {
  cd "$ROOT/examples/serdepy" || return 1
  step "tessercheck (zero findings over the whole tree)"
