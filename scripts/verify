#!/usr/bin/env bash
#
# Every Python gate CI runs, runnable locally, one command per tree.
#
#   scripts/verify              all trees
#   scripts/verify python-app   one tree
#   scripts/verify serdepy python-app
#
# Each CI job calls this with its own tree, so the commands live here — in the
# repo, reviewable — rather than inline in workflow YAML. That is the point:
# "green locally" and "green in CI" have to mean the same thing, and they only
# do if there is one definition of what green is.
#
# Tools are taken from PATH, exactly as in CI. Install them into the active
# environment with scripts/install-dev.
#
set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT" || exit 1

# Step 0 is the layout app (layout/ — a full tesser app with its own gates):
# it fails when the directories on disk, manifest.json, the .tesser-root
# files, and the CI jobs disagree in any direction. The tree list also comes
# from the layout app, never hand-maintained here: an `app` manifest row IS
# the claim that scripts/verify runs that tree, and a manifest tree with no
# run_* arm below fails as "unknown tree" rather than silently not running.
(cd "$ROOT/layout" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.check "$ROOT") || exit 1

# Capture the output in a variable first: a python3 failure inside process
# substitution would be invisible, and an empty TREES list would make the
# loop below report "all green (0 trees)" — a check that passes without
# checking anything.
TREE_LIST=$( (cd "$ROOT/layout" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.trees "$ROOT") ) || { echo "verify: could not derive trees from manifest.json" >&2; exit 1; }
# Read with a while loop, not mapfile: mapfile is a bash 4 builtin and macOS
# ships bash 3.2. Every CI job runs on ubuntu, so a bash-4-ism here fails only
# on the machine this script exists to serve, and CI can never see it.
TREES=()
while IFS= read -r tree; do
  if [ -n "$tree" ]; then TREES+=("$tree"); fi
done <<<"$TREE_LIST"
if [ ${#TREES[@]} -eq 0 ] || [ -z "${TREES[0]}" ]; then
  echo "verify: no gated trees derived from manifest.json" >&2
  exit 1
fi

failed=()

step() { echo "  → $*"; }

# The analyzer is an app, and an app is run through its host: tessercheck-py's
# srv/cli/main.py. It runs from tessercheck-py's own directory — `-m
# srv.cli.main` resolves against the current directory first, and a checked
# tree may have an srv package of its own — so the tree to check is an
# argument, not the working directory.
tessercheck_tree() {
  (cd "$ROOT/tessercheck-py" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.main "$1")
}

run_llmport() {
  cd "$ROOT/examples/llmport" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict scheduling protocol conftest.py || return 1
  step "pytest"
  pytest -q || return 1
}

run_python_app() {
  cd "$ROOT/examples/python-app" || return 1
  step "ruff (env edge + exit edge + dead imports + F823)"
  ruff check . || return 1
  step "import-linter (import direction)"
  PYTHONPATH=. lint-imports || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict protocol kernel campaign linkpolicy reports app srv tests conftest.py || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "pytest (every tier; the root conftest serves the host)"
  pytest -q || return 1
}

# The canonical application-ports tree: one context, two ports, an enum outcome
# and a collection answer. The six rejected encodings it was chosen over are not
# here on purpose — four of them exist *because* they produce findings, so a
# zero-findings gate is the wrong shape for them. They stay executable on the
# spike/application-ports branch, and docs/design-application-ports.md carries
# the measurements.
run_ports() {
  cd "$ROOT/examples/ports" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict catalog || return 1
  step "pytest"
  pytest -q || return 1
}

# The minimal tree: a small app that uses every tesser role and object in a
# conformant way, with about one test per sibling test file and the least
# business logic that shows how things work. Two contexts, a kernel, an
# exported kernel, protocol, srv, and app; alpha's durable kinds run on
# Restate and its widgets are in Postgres. The tests own their infrastructure
# (docs/design-test-tiers.md): a plain pytest runs every tier, and the root
# conftest starts what they ask for — a private Restate engine, a private
# Postgres (storage_url), and for the root tier a second private engine with
# srv/restate served and registered on it (host_engine_url), the CLI host run
# as a subprocess per command. Docker is the one prerequisite.
run_minimal() {
  cd "$ROOT/examples/minimal" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict kernel shared protocol alpha beta app srv tests conftest.py || return 1
  step "pytest (every tier; private engines and Postgres from the root conftest)"
  pytest -q || return 1
}

# The durable-execution example: one context whose workflows run on Restate.
# One FastAPI host serves POST /submissions, /orders and /purchases and mounts
# the Restate endpoint at /restate; the engine never touches the domain. The
# adapter tests exercise the real engine (testing.md rule 10). The tests own
# their infrastructure (docs/design-test-tiers.md): a plain pytest runs every
# tier, and the root conftest starts a private Restate engine for the context
# and adapter tiers and, for the root tier, a second private engine with the
# HTTP host served as a subprocess and registered on it (the `host` fixture;
# `--host <url>` points the root tier at a host already served). Docker is the
# one prerequisite.
run_durable_execution() {
  cd "$ROOT/examples/durable-execution" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict protocol ordering app srv tests conftest.py || return 1
  step "pytest (every tier; private engines from the root conftest)"
  pytest -q || return 1
}

# The minimal tree with a real database behind it: the same two contexts, each
# with an asyncpg repository behind a store that owns the transaction — it is
# Postgres-only, there is no memory backend to fall back to — an async
# client/service/port chain, and an e2e that runs the CLI host as a
# subprocess and speaks only protocol to it. The app reads its own
# environment through the config repository, which takes the environment it
# reads; a test hands the host subprocess the database explicitly. The tests
# start a private Postgres of their own (the root conftest's storage_url
# fixture, docs/design-test-tiers.md), so the gate needs Docker and nothing
# running beforehand. There is no skip, because a skipped e2e is a gate that
# passes without checking anything.
run_asyncpg() {
  cd "$ROOT/examples/asyncpg" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict kernel shared protocol alpha beta app srv tests pgdatabase conftest.py || return 1
  step "pytest (the tests start their own private Postgres)"
  pytest -q || return 1
}

run_serdepy() {
  cd "$ROOT/examples/serdepy" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict conftest.py parcel || return 1
  step "pytest"
  pytest -q || return 1
}

run_errorspy() {
  cd "$ROOT/examples/errorspy" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict storage conftest.py protocol campaign || return 1
  step "pytest"
  pytest -q || return 1
}

run_tesser_py() {
  cd "$ROOT/tesser-py" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  mypy || return 1
  # The mutmut fixture projects are excluded from the tree's own mypy run
  # (each ships a package named vo, which would collide), so each gets its
  # own strict invocation here — the cross-package consumer check the
  # retired vobase job used to provide.
  step "mypy --strict (mutmut fixtures)"
  # --cache-dir=/dev/null: a .mypy_cache left inside a fixture would be
  # copytree'd into the mutation runs (the test ignores known junk dirs, but
  # not creating the junk is the honest half of that contract).
  for fixture in tests/ecosystem/mutmut/fixtures/*/; do
    (cd "$fixture" && MYPYPATH=../../../../..:. mypy --strict --cache-dir=/dev/null vo tests) || return 1
  done
  step "pytest"
  pytest -q || return 1
  step "built wheel ships every subpackage"
  # Clean before and after: `pip wheel` leaves build/ and *.egg-info/ behind,
  # and build/lib/ is a full duplicate of the source tree. tessercheck's reader
  # now prunes build/ and dist/, but *.egg-info is not in the skip set and a
  # clean tree is the honest baseline either way.
  rm -rf dist build ./*.egg-info
  trap 'rm -rf "$ROOT/tesser-py/dist" "$ROOT/tesser-py/build" "$ROOT"/tesser-py/*.egg-info' RETURN
  pip wheel --no-deps -w dist . > /dev/null || return 1
  python3 - <<'EOF' || return 1
import glob, pathlib, sys, zipfile
names = zipfile.ZipFile(glob.glob("dist/*.whl")[0]).namelist()
shipped = {n.split("/")[1] for n in names if n.startswith("tesser/") and n.count("/") == 2}
shipped |= {n.split("/")[1] for n in names if n.startswith("tesser/") and n.count("/") == 1 and n.endswith(".py")}
on_disk = {p.parent.name for p in pathlib.Path("tesser").glob("*/__init__.py")}
on_disk |= {
    p.name
    for p in pathlib.Path("tesser").glob("*.py")
    if p.name != "__init__.py" and not p.name.startswith("test_")
}
missing = on_disk - shipped
if missing:
    sys.exit(f"wheel omits subpackages or modules: {sorted(missing)}")
print(f"wheel ships: {sorted(on_disk)}")
EOF
}

# The specs app: the product specification page and the service behind it.
# One context (specification), one HTTP host that serves the page at / and
# POST /jtbd/{id}/stories, and root-tier tests that play the user: one posts
# a story over HTTP, one drives the page through Playwright — so this tree
# needs a browser (python -m playwright install chromium) as well as the
# Python tooling. The root conftest serves the host itself on a port the OS
# picks (docs/design-test-tiers.md), so the arm is the gates and one pytest.
run_specs_app() {
  cd "$ROOT/specs-app" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../tesser-py mypy --strict protocol specification app srv tests conftest.py || return 1
  step "pytest (every tier; the tests serve their own host)"
  pytest -q || return 1
}

# A rendered app: a tree srv.cli.render writes from the specs in its specs/
# directory, then red and green agents complete (scripts/app/README.md). The
# story-drafting app is one, and the repo's baseline for measuring how agents
# build a tesser app from its stories (scripts/baseline/). A rendered tree
# carries .tesser-rendered, whose first line is its composition directory
# (relative to the repo root); the arm then first checks the tree against it
# (srv.cli.render --check), so a hand edit to a generated file fails the gate.
# It needs Docker: the tests start their own private Restate engines and serve
# the host themselves (docs/design-test-tiers.md).
run_rendered_app() {
  local app=$1
  cd "$ROOT/$app" || return 1
  if [ -f .tesser-rendered ]; then
    local composition
    composition=$(head -n 1 .tesser-rendered)
    step "the tree matches $composition (srv.cli.render --check)"
    (cd "$ROOT/generator" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.render --check "$ROOT/$composition" "$ROOT/$app") || return 1
  fi
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  local targets=()
  local d
  for d in */; do
    if [ -f "$d/__init__.py" ]; then targets+=("${d%/}"); fi
  done
  if [ -f conftest.py ]; then targets+=(conftest.py); fi
  if [ ${#targets[@]} -gt 0 ]; then
    step "mypy --strict"
    MYPYPATH=.:../tesser-py mypy --strict "${targets[@]}" || return 1
  fi
  step "pytest (every tier; the tests start their own engines and host)"
  pytest -q
}

# The voice example: one context (calls) whose root-tier test places a call
# for a person through the CLI host (srv.cli.main place-call, run as a
# subprocess) and reads the person's name back by the call id through the same
# host (get-call), speaking only protocol. place_call runs the
# CallOrchestrator workflow on Restate, and its record_call action writes the
# call through an asyncpg repository; get_call reads it back directly. The
# tests own their infrastructure (docs/design-test-tiers.md): a plain pytest
# runs every tier, and the root conftest starts a private Restate engine, a
# private Postgres (storage_url), and for the root tier a second private
# engine with srv/restate served and registered on it (host_engine_url). The
# root tier is an opt-in eval against real LiveKit and model APIs: it skips
# unless VOICE_EVALS=1, and then takes LIVEKIT_URL, LIVEKIT_API_KEY,
# LIVEKIT_API_SECRET and a LIVEKIT_AGENT_NAME no other worker serves from the
# environment, and its fixtures also serve the LiveKit agent server. Docker is
# the one prerequisite of everything else.
run_voice() {
  cd "$ROOT/examples/voice" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict app calls pgdatabase protocol simulated srv tests conftest.py || return 1
  step "pytest (every tier; private engines and Postgres from the root conftest)"
  pytest -q || return 1
}

run_layout() {
  cd "$ROOT/layout" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../tesser-py mypy --strict repo protocol app srv conftest.py || return 1
  step "pytest"
  pytest -q || return 1
}

# The generator app (generator/) writes a tesser app tree from a TOML spec: a
# context whose service runs a Restate workflow, whose orchestrator runs one
# action, and whose action writes to its store — Postgres, or memory when the
# spec says `storage = "memory"` — served by a CLI host beside a Restate host, or
# by one HTTP host that mounts the Restate endpoint at /restate when the spec
# says `host = "http"`. Its own gates run first. Then every spec in
# generator/specs/ is generated into a scratch directory and the generated tree
# is gated at the bar of an example: tessercheck zero findings, mypy --strict,
# and a plain pytest from the tree's root. The generated root conftest.py owns
# the infrastructure (docs/design-test-tiers.md, "The tests own their
# infrastructure"): private Restate engines and, for a postgres tree, a private
# Postgres, each a container started on first use, and the generated host
# served and registered on an engine of its own — so the arm starts nothing,
# serves nothing, and sets no variable for the tree; it needs Docker. Then every composition in
# generator/compositions/ is rendered by the composition-driven renderer
# (srv.cli.render) into a scratch directory, checked against its composition
# (srv.cli.render --check), and gated: tessercheck zero findings, mypy
# --strict, and a plain pytest from the rendered tree's root. Nothing is served
# beforehand and nothing is read from the environment: the rendered root
# conftest.py starts the HTTP host the tests ask for and, when the composition
# declares an engine, the engines (Docker)
# (docs/design-test-tiers.md, "The tests own their infrastructure"). A
# rendered root test calls its story's route on the served host and asserts its
# status; a story whose given has to be set up first (a read of something
# created) answers another status until its author writes the given, so the arm
# reads pytest's report and passes when every other test passed and every
# failure is a root test's status assertion (the served host answered).
run_generator() {
  cd "$ROOT/generator" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../tesser-py mypy --strict app protocol rendering srv tests trees conftest.py || return 1
  step "pytest"
  pytest -q || return 1
  local scratch
  scratch=$(mktemp -d) || return 1
  local spec
  for spec in specs/*.toml; do
    run_generated_tree "$spec" "$scratch/$(basename "$spec" .toml)" || return 1
  done
  local composition
  for composition in compositions/*/; do
    run_rendered_tree "${composition%/}" "$scratch/rendered-$(basename "$composition")" || return 1
  done
  rm -rf "$scratch"
}

run_rendered_tree() {
  local composition=$1
  local out=$2
  step "render $composition into $out"
  PYTHONPATH=.:../tesser-py python3 -m srv.cli.render "$composition" "$out" >/dev/null || return 1
  step "$composition: the rendered tree matches its composition (srv.cli.render --check)"
  PYTHONPATH=.:../tesser-py python3 -m srv.cli.render --check "$composition" "$out" || return 1
  step "$composition: tessercheck (zero findings over the rendered tree)"
  tessercheck_tree "$out" || return 1
  local packages=()
  local d
  for d in "$out"/*/; do
    if [ -f "$d/__init__.py" ]; then packages+=("$(basename "$d")"); fi
  done
  if [ -f "$out/conftest.py" ]; then packages+=(conftest.py); fi
  step "$composition: mypy --strict"
  (cd "$out" && MYPYPATH=".:$ROOT/tesser-py" mypy --strict "${packages[@]}") || return 1
  step "$composition: pytest (every tier; the tests start the engines and the host they take)"
  local report
  report=$(mktemp) || return 1
  (cd "$out" && PYTHONPATH=".:$ROOT/tesser-py" pytest -q -p no:cacheprovider --junitxml="$report")
  step "$composition: every failure is a root test whose route answered a status other than its story's"
  local judged=0
  python3 - "$report" <<'PY' || judged=$?
import re
import sys
import xml.etree.ElementTree as element_tree

cases = list(element_tree.parse(sys.argv[1]).getroot().iter("testcase"))
unexpected = []
for case in cases:
    for outcome in ("failure", "error"):
        for found in case.findall(outcome):
            message = found.get("message") or ""
            answered = (
                outcome == "failure"
                and case.get("classname", "").startswith("tests.")
                and re.search(r"\nassert \d+ == \d+$", message) is not None
            )
            if not answered:
                unexpected.append(f"{case.get('classname')}::{case.get('name')} ({outcome}): {message}")
if not cases:
    unexpected.append("pytest ran no tests")
for line in unexpected:
    print(f"  not a root test's status: {line}", file=sys.stderr)
sys.exit(1 if unexpected else 0)
PY
  rm -f "$report"
  return "$judged"
}

run_generated_tree() {
  local spec=$1
  local out=$2
  step "generate $spec into $out"
  PYTHONPATH=.:../tesser-py python3 -m srv.cli.generate "$spec" "$out" >/dev/null || return 1
  step "$spec: tessercheck (zero findings over the generated tree)"
  tessercheck_tree "$out" || return 1
  local packages=("tests" "conftest.py")
  local d
  for d in "$out"/*/; do
    if [ -f "$d/__init__.py" ] && [ "$(basename "$d")" != tests ]; then packages+=("$(basename "$d")"); fi
  done
  step "$spec: mypy --strict"
  (cd "$out" && MYPYPATH=".:$ROOT/tesser-py" mypy --strict "${packages[@]}") || return 1
  step "$spec: pytest (every tier; the tree's conftest.py starts its engines, storage, and host)"
  (cd "$out" && PYTHONPATH=".:$ROOT/tesser-py" pytest -q -p no:cacheprovider)
}

run_tessercheck_py() {
  cd "$ROOT/tessercheck-py" || return 1
  step "tessercheck (self-check over its own tree)"
  tessercheck_tree "$PWD" || return 1
  step "RULES.md drift gate"
  PYTHONPATH=.:../tesser-py python3 -m srv.cli.rules --check || return 1
  step "mypy --strict"
  MYPYPATH=.:../tesser-py mypy || return 1
  step "pytest"
  pytest -q || return 1
  step "import contracts"
  PYTHONPATH=.:../tesser-py lint-imports --no-cache || return 1
}

run_tree() {
  local tree=$1
  echo
  echo "=== $tree ==="
  case "$tree" in
    llmport)        run_llmport ;;
    python-app)     run_python_app ;;
    minimal)        run_minimal ;;
    durable-execution) run_durable_execution ;;
    asyncpg)        run_asyncpg ;;
    serdepy)        run_serdepy ;;
    ports)          run_ports ;;
    errorspy)       run_errorspy ;;
    tesser-py)      run_tesser_py ;;
    specs-app)      run_specs_app ;;
    story-drafting) run_rendered_app story-drafting ;;
    voice)          run_voice ;;
    layout)         run_layout ;;
    generator)      run_generator ;;
    tessercheck-py) run_tessercheck_py ;;
    *) echo "unknown tree: $tree (known: ${TREES[*]})"; return 1 ;;
  esac
}

selected=("$@")
if [ ${#selected[@]} -eq 0 ]; then
  selected=("${TREES[@]}")
fi

for tree in "${selected[@]}"; do
  if run_tree "$tree"; then
    echo "  PASS $tree"
  else
    echo "  FAIL $tree"
    failed+=("$tree")
  fi
done

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "all green (${#selected[@]} tree(s))"
  exit 0
fi
echo "FAILED: ${failed[*]}"
exit 1
