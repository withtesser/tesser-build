class TestRestateEngineRefusals:

    async def test_a_body_the_snapshot_cannot_read_is_a_terminal_500_that_is_not_retried(
        self, engine_url: str, engine_admin_url: str, engine_callback_host: str, free_port: int
    ) -> None:
        {{container_attr}} = restate.Service(f"{{container}}{uuid.uuid4().hex}")
        {{activity_param}} = activities.{{Activity}}({{container_attr}}, Fake{{ApplicationClient}}())
        port = free_port
        hypercorn_config_config = hypercorn_config.Config()
        hypercorn_config_config.bind = [f"0.0.0.0:{port}"]
        shutdown = asyncio.Event()
        serving = asyncio.create_task(
            hypercorn_asyncio.serve(
                typing.cast(hypercorn_typing.ASGIFramework, restate.app([{{container_attr}}])),
                hypercorn_config_config,
                shutdown_trigger=shutdown.wait,
            )
        )
        admin = httpx.AsyncClient(base_url=engine_admin_url, timeout=10.0)
        registered = httpx.Response(503)
        try:
            registering_until = asyncio.get_running_loop().time() + 30.0
            while True:
                registered = await admin.post(
                    "/deployments",
                    json={"uri": f"http://{engine_callback_host}:{port}", "force": True},
                )
                if registered.is_success or asyncio.get_running_loop().time() > registering_until:
                    break
                await asyncio.sleep(0.1)
            assert registered.is_success, registered.text

            async with httpx.AsyncClient(base_url=engine_url, timeout=30.0) as async_client:
                with pytest.raises(restate.HttpError) as refused:
                    await restate_client.Client(async_client).generic_call(
                        {{container_attr}}.name, {{activity_param}}.handler.__name__,
                        b"[1, 2]",
                        headers={"content-type": "application/json"},
                    )

            assert refused.value.status_code == 500
            assert json.loads(refused.value.body or "")["message"].startswith("Unable to parse an input argument.")
        finally:
            if registered.is_success:
                await admin.delete(f"/deployments/{registered.json()['id']}", params={"force": "true"})
            await admin.aclose()
            shutdown.set()
            await asyncio.wait([serving], timeout=1.0)
            serving.cancel()
            await asyncio.wait_for(asyncio.gather(serving, return_exceptions=True), timeout=5.0)

