def answering(served: subprocess.Popen[bytes], address: str) -> None:
    deadline = time.monotonic() + DEADLINE_SECONDS
    answer = ""
    while time.monotonic() < deadline:
        if served.poll() is not None:
            pytest.fail(f"the host exited with {served.returncode} before it answered")
        try:
            httpx.get(address, timeout=5.0)
        except httpx.HTTPError as not_yet:
