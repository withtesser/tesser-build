    def {{test_method}}(self) -> None:
        cli = ts.Cli("srv.cli.main")
        {{asserts}} = random.choice({{random_choices}})

        {{write}} = cli.run(
            "{{write}}",
{{#fields}}
            {{#is_asserted}}str({{asserts}}){{/is_asserted}}{{^is_asserted}}{{sample_arg}}{{/is_asserted}},
{{/fields}}
        )
        {{read}} = cli.run("{{read}}", {{write}}.stdout.strip())

        assert ({{write}}.exit_code, {{write}}.stderr) == (0, "")
        assert ({{read}}.exit_code, {{read}}.stderr) == (0, "")
        assert "{{asserts}}=" + str({{asserts}}) in {{read}}.lines()
