class TestConfig:
{{#storage_postgres}}

    def test_a_postgres_coordinate_requests_that_database(self) -> None:
        spec = component.Spec({{#storage_postgres}}storage="postgres://a@b/c", {{/storage_postgres}}engine_url="http://localhost:8080", identity_seed=7)

        config = component.Config(spec)

