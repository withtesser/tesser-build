class Test{{Context}}:

    async def test_the_component_publishes_the_engine_containers_it_registered_into(self) -> None:
        config = component.Config(
            component.Spec({{#storage_postgres}}storage="postgres://nobody@nowhere/none", {{/storage_postgres}}engine_url="http://localhost:8080", identity_seed=7)
        )

        {{context}} = component.{{Context}}(config{{#storage_postgres}}, pgdatabase_database.Database(config.database){{/storage_postgres}})
        registered = {
            {{context}}.{{aggregate}}_actions_service.name: sorted({{context}}.{{aggregate}}_actions_service.handlers),
            {{context}}.{{aggregate}}_orchestrator_workflow.name: sorted(
                {{context}}.{{aggregate}}_orchestrator_workflow.handlers
            ),
        }
        await {{context}}.close()

        assert registered == {"{{Aggregate}}Actions": ["{{record}}"], "{{Aggregate}}Orchestrator": ["{{conduct}}"]}

    async def test_every_container_bounds_its_retries_and_only_the_workflow_is_reachable_at_the_engine_url(self) -> None:
        config = component.Config(
            component.Spec({{#storage_postgres}}storage="postgres://nobody@nowhere/none", {{/storage_postgres}}engine_url="http://localhost:8080", identity_seed=7)
        )

        {{context}} = component.{{Context}}(config{{#storage_postgres}}, pgdatabase_database.Database(config.database){{/storage_postgres}})
        declared = [
            (
                registered.name,
                registered.ingress_private,
                registered.invocation_retry_policy.max_attempts if registered.invocation_retry_policy else None,
                registered.invocation_retry_policy.on_max_attempts if registered.invocation_retry_policy else None,
            )
            for registered in ({{context}}.{{aggregate}}_actions_service, {{context}}.{{aggregate}}_orchestrator_workflow)
        ]
        await {{context}}.close()

        assert declared == [
            ("{{Aggregate}}Actions", True, 5, "pause"),
            ("{{Aggregate}}Orchestrator", None, 5, "pause"),
        ]
