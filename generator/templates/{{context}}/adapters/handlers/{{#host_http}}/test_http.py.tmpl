from __future__ import annotations

import json

import pytest
import tesser.testing as ts

import {{context}}.adapters.handlers as handlers
import {{context}}.client as client
import protocol


@ts.fake
class Fake{{Context}}Client(client.{{Context}}Client):

    def __init__(self) -> None:
        self.{{write}}_requests: list[client.{{Write}}Request] = []
        self.{{read}}_requests: list[client.{{Read}}Request] = []

    async def {{write}}(self, {{write}}_request: client.{{Write}}Request) -> client.{{Write}}Response:
        self.{{write}}_requests.append({{write}}_request)
        return client.{{Write}}Response({{identity}}={{identity_sample}})

    async def {{read}}(self, {{read}}_request: client.{{Read}}Request) -> client.{{Read}}Response:
        self.{{read}}_requests.append({{read}}_request)
        return client.{{Read}}Response(client.{{Aggregate}}({{#read_fields}}{{field}}={{sample}}{{comma}}{{/read_fields}}))


class TestHttpHandler:

    async def test_{{write}}_passes_each_body_field_as_its_field_and_answers_the_{{identity}}(self) -> None:
        fake_{{context}}_client = Fake{{Context}}Client()

        http_response = await handlers.HttpHandler(fake_{{context}}_client).{{write}}(
            protocol.HttpRequest(
                path_params={}, body=json.dumps({{{#fields}}"{{field}}": {{sample}}{{comma}}{{/fields}}}).encode()
            )
        )

        assert (http_response.status_code, json.loads(http_response.body)) == (201, {"{{identity}}": {{identity_sample}}})
        assert fake_{{context}}_client.{{write}}_requests == [
            client.{{Write}}Request({{#fields}}{{field}}={{sample}}{{comma}}{{/fields}})
        ]

    async def test_{{write}}_missing_a_field_is_a_bad_request_that_calls_nothing(self) -> None:
        fake_{{context}}_client = Fake{{Context}}Client()

        with pytest.raises(protocol.BadRequest):
            await handlers.HttpHandler(fake_{{context}}_client).{{write}}(protocol.HttpRequest(path_params={}, body=b"{}"))

        assert fake_{{context}}_client.{{write}}_requests == []

    async def test_{{read}}_answers_the_fields_it_reads_for_the_{{identity}}_in_the_path(self) -> None:
        fake_{{context}}_client = Fake{{Context}}Client()

        http_response = await handlers.HttpHandler(fake_{{context}}_client).{{read}}(
            protocol.HttpRequest(path_params={"{{identity}}": {{identity_sample}}}, body=b"")
        )

        assert (http_response.status_code, json.loads(http_response.body)) == (
            200,
            {{{#read_fields}}"{{field}}": {{sample}}{{comma}}{{/read_fields}}},
        )
        assert fake_{{context}}_client.{{read}}_requests == [client.{{Read}}Request({{identity}}={{identity_sample}})]

    async def test_{{read}}_without_a_{{identity}}_is_a_bad_request_that_calls_nothing(self) -> None:
        fake_{{context}}_client = Fake{{Context}}Client()

        with pytest.raises(protocol.BadRequest):
            await handlers.HttpHandler(fake_{{context}}_client).{{read}}(protocol.HttpRequest(path_params={}, body=b""))

        assert fake_{{context}}_client.{{read}}_requests == []
