from __future__ import annotations

import asyncio
import sys
import traceback
import typing

import tesser.srv as ts
import fastapi
import hypercorn.asyncio as hypercorn_asyncio
import hypercorn.config as hypercorn_config
import hypercorn.typing as hypercorn_typing
import restate

import app as app
import {{context}}.adapters.handlers as {{context}}_handlers
import protocol

_BIND: typing.Final[str] = "0.0.0.0:8000"
_RESTATE_DEPLOYMENT_PATH: typing.Final[str] = "/restate"
_JSON: typing.Final[str] = "application/json"


class HttpRoutes(ts.Host):

    def __init__(self, http_handler: {{context}}_handlers.HttpHandler) -> None:
        self._http_handler = http_handler

    async def {{write}}(self, request: fastapi.Request) -> fastapi.Response:
        try:
            http_response = await self._http_handler.{{write}}(
                protocol.HttpRequest(path_params=request.path_params, body=await request.body())
            )
        except protocol.BadRequest as error:
            http_response = protocol.HttpResponse.problem(400, str(error))
        except Exception:
            traceback.print_exc(file=sys.stderr)
            http_response = protocol.HttpResponse.problem(500, "unexpected error")
        return fastapi.Response(http_response.body, http_response.status_code, media_type=_JSON)

    async def {{read}}(self, request: fastapi.Request) -> fastapi.Response:
        try:
            http_response = await self._http_handler.{{read}}(
                protocol.HttpRequest(path_params=request.path_params, body=await request.body())
            )
        except protocol.BadRequest as error:
            http_response = protocol.HttpResponse.problem(400, str(error))
        except Exception:
            traceback.print_exc(file=sys.stderr)
            http_response = protocol.HttpResponse.problem(500, "unexpected error")
        return fastapi.Response(http_response.body, http_response.status_code, media_type=_JSON)


class HttpHost(ts.Host):

    def run(self, argv: list[str]) -> int:
        {{app}}_app = app.load()
        http_routes = HttpRoutes({{context}}_handlers.HttpHandler({{app}}_app.{{context}}.client))
        api = fastapi.FastAPI()
        api.add_api_route("/{{collection}}", http_routes.{{write}}, methods=["POST"])
        api.add_api_route("/{{collection}}/{{{identity}}}", http_routes.{{read}}, methods=["GET"])
        api.mount(
            _RESTATE_DEPLOYMENT_PATH,
            restate.app(
                [
                    {{app}}_app.{{context}}.{{aggregate}}_actions_service,
                    {{app}}_app.{{context}}.{{aggregate}}_orchestrator_workflow,
                ]
            ),
        )
        config = hypercorn_config.Config()
        config.bind = [argv[0] if argv else _BIND]
        served = typing.cast(hypercorn_typing.ASGIFramework, api)
        with asyncio.Runner() as runner:
            runner.run({{app}}_app.open())
            try:
                runner.run(hypercorn_asyncio.serve(served, config))
            finally:
                runner.run({{app}}_app.close())
        return 0


if __name__ == "__main__":
    ts.main(HttpHost().run)
