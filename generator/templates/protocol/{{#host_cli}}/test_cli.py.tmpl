from __future__ import annotations

import pytest

import protocol


class TestCliRequest:

    def test_an_argument_at_its_index_comes_back(self) -> None:
        cli_request = protocol.CliRequest(args=("a", "b"))

        assert (cli_request.arg(0, "first", "usage: prog"), cli_request.arg(1, "second", "usage: prog")) == ("a", "b")

    def test_a_missing_argument_names_itself_and_carries_the_usage(self) -> None:
        with pytest.raises(protocol.UsageError) as raised:
            protocol.CliRequest(args=()).arg(0, "first", "usage: prog <first>")

        assert str(raised.value) == "missing argument <first>\nusage: prog <first>"

    def test_an_empty_argument_is_a_missing_argument(self) -> None:
        with pytest.raises(protocol.UsageError) as raised:
            protocol.CliRequest(args=("",)).arg(0, "first", "usage: prog <first>")

        assert str(raised.value) == "missing argument <first>\nusage: prog <first>"

    def test_a_whole_number_argument_reads_as_an_int(self) -> None:
        assert protocol.CliRequest(args=("-13",)).int_arg(0, "count", "usage: prog <count>") == -13

    def test_an_argument_that_is_not_a_whole_number_is_a_usage_error(self) -> None:
        with pytest.raises(protocol.UsageError) as raised:
            protocol.CliRequest(args=("three",)).int_arg(0, "count", "usage: prog <count>")

        assert str(raised.value) == "argument <count> is not a whole number: three\nusage: prog <count>"

    def test_the_exact_argument_count_passes_the_extra_argument_gate(self) -> None:
        protocol.CliRequest(args=("a",)).no_extra_args(1, "usage: prog")

    def test_an_extra_argument_is_rejected_with_the_usage(self) -> None:
        with pytest.raises(protocol.UsageError) as raised:
            protocol.CliRequest(args=("a", "b")).no_extra_args(1, "usage: prog <first>")

        assert str(raised.value) == "unexpected extra arguments\nusage: prog <first>"

    def test_two_requests_with_the_same_arguments_are_equal(self) -> None:
        assert protocol.CliRequest(args=("a", "b")) == protocol.CliRequest(args=("a", "b"))
        assert protocol.CliRequest(args=("a", "b")) != protocol.CliRequest(args=("b", "a"))


class TestCliResponse:

    def test_ok_is_exit_zero_on_stdout_with_an_empty_stderr(self) -> None:
        assert protocol.CliResponse.ok("done") == protocol.CliResponse(0, stdout="done", stderr="")

    def test_two_responses_with_the_same_fields_are_equal(self) -> None:
        assert protocol.CliResponse(2, stdout="", stderr="boom") == protocol.CliResponse(2, stdout="", stderr="boom")
        assert protocol.CliResponse(2, stdout="", stderr="boom") != protocol.CliResponse(1, stdout="", stderr="boom")
