from __future__ import annotations

import tesser.testing as ts

import app
import {{context}}.component as {{context}}_component


@ts.fake
class FakeConfigRepository(app.AppConfigRepository):

    def get(self) -> app.AppConfig:
        return app.AppConfig(
            app.Spec(
                {{context}}_component.Config(
                    {{context}}_component.Spec({{#storage_postgres}}"postgres://a@b/{{context}}", {{/storage_postgres}}"http://engine.invalid:8080", 7)
                )
            )
        )


class TestAppConfig:

    def test_a_config_carries_the_{{context}}_config(self) -> None:
        spec = app.Spec(
            {{context}}_component.Config(
                {{context}}_component.Spec({{#storage_postgres}}"postgres://a@b/{{context}}", {{/storage_postgres}}"http://localhost:8080", 7)
            )
        )

        app_config = app.AppConfig(spec)

        assert app_config.{{context}} is spec.{{context}}


class TestEnvConfigRepository:

    def test_the_environment_is_read_into_a_config(self) -> None:
        app_config = app.EnvConfigRepository(
            {
{{#storage_postgres}}
                "{{storage_env}}": "postgres://a@b/{{context}}",
{{/storage_postgres}}
                "{{engine_url_env}}": "http://engine.invalid:8080",
            }
        ).get()

{{#storage_postgres}}
        assert app_config.{{context}}.storage == "postgres://a@b/{{context}}"
{{/storage_postgres}}
        assert app_config.{{context}}.engine_url == "http://engine.invalid:8080"

    def test_each_read_draws_a_new_identity_seed(self) -> None:
        env_config_repository = app.EnvConfigRepository(
            {
{{#storage_postgres}}
                "{{storage_env}}": "postgres://a@b/{{context}}",
{{/storage_postgres}}
                "{{engine_url_env}}": "http://engine.invalid:8080",
            }
        )

        first = env_config_repository.get()
        second = env_config_repository.get()

        assert first.{{context}}.identity_seed != second.{{context}}.identity_seed


class TestAppLoader:

    def test_the_loader_builds_an_app_that_publishes_the_{{context}}_client(self) -> None:
        {{app}}_app = app.AppLoader(FakeConfigRepository()).load()

        assert {{app}}_app.{{context}}.client is not None
